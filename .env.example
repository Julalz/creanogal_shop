# URL pública del sitio (redirecciones de pago, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Frontend (legacy / alternativa)
FRONTEND_URL=http://creanogal.es

# Pago con tarjeta (claves en el panel del proveedor de pagos)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook: whsec_ en local con el CLI del proveedor; en producción, del panel de webhooks
STRIPE_WEBHOOK_SECRET=

# Envío de emails del formulario de contacto y pedidos (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# Datos legales (aviso legal, SeQura) — obligatorio en producción
COMPANY_LEGAL_NAME=Creanogal
COMPANY_TAX_ID=

# SeQura — portal-sandbox.sequra.com → Desarrollo → Credenciales API
SEQURA_ACCOUNT_KEY=          # Nombre de usuario
SEQURA_ACCOUNT_SECRET=       # Contraseña (campo "Contraseña", NO "Secreto de activos")
SEQURA_MERCHANT_ID=          # ID de Merchant (en sandbox puede coincidir con el usuario)
SEQURA_ASSETS_KEY=             # Secreto de activos (solo widgets)
SEQURA_ENV=sandbox
