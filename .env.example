# URL pública del sitio (Stripe redirects, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Frontend (legacy / alternativa)
FRONTEND_URL=http://creanogal.es

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# En local: copia el whsec_ que muestra `stripe listen` al arrancar (cambia en cada sesión)
# En producción: whsec_ del webhook en Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=

# Envío de emails del formulario de contacto y pedidos (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# SeQura (activar cuando recibas credenciales)
# SEQURA_ACCOUNT_KEY=
# SEQURA_ACCOUNT_SECRET=
# SEQURA_MERCHANT_ID=
# SEQURA_ASSETS_KEY=
# SEQURA_ENV=sandbox
